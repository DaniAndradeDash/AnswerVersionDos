# ============================================
# AnswerST — Environment Variables
# ============================================
# Copiar este archivo a .env y completar los valores.
# NUNCA commitear el archivo .env al repositorio.
# ============================================

# -------------------------------------------
# Desarrollo — Mailtrap (sandbox SMTP)
# Usado por la API route de Next.js (/api/contact)
# -------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
MAILTRAP_USER=tu_usuario_mailtrap
MAILTRAP_PASS=tu_password_mailtrap

# Email que recibe los mensajes en desarrollo
EMAILJS_USER=daniandrademty@gmail.com

# -------------------------------------------
# Producción — Neubox (SMTP del hosting)
# Usado por el script PHP (phpmailer/sendmail.php)
# -------------------------------------------
SMTP_HOST=mail.answerst.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=contacto@answerst.com
SMTP_PASSWORD=tu_password_del_correo

# -------------------------------------------
# Opcional — CORS para producción
# Restringir el origen del formulario
# -------------------------------------------
# ALLOWED_ORIGIN=https://www.answerst.com

# -------------------------------------------
# PHPMailer (solo producción)
# Las credenciales se leen desde .env via loadEnv()
# El script PHP las encuentra en ../.env (raíz del proyecto)
# -------------------------------------------
